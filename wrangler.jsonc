{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secure-p2p-file-transfer",
  "account_id": "8ed2bc59fe8a84a9696c3ab792512a3c",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "send.718788.xyz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TransferRoom"
      },
      {
        "name": "SESSION_LIMITERS",
        "class_name": "ClientSessionLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TransferRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ClientSessionLimiter"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "SPILLOVER",
      "bucket_name": "secure-p2p-spillover"
    }
  ],
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "secure-p2p-stats",
      "database_id": "7d874680-d64c-457c-bee1-1e564363700c"
    }
  ],
  "triggers": {
    "crons": ["55 23 * * *"]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "8ed2bc59fe8a84a9696c3ab792512a3c",
    "STATS_R2_BUCKET_NAME": "secure-p2p-spillover",
    "ROOM_TTL_SECONDS": "86400",
    "TURN_TTL_SECONDS": "900",
    "SPILLOVER_CAP_BYTES": "10737418240",
    "MAX_RELAY_REQUEST_BYTES": "67108864"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
